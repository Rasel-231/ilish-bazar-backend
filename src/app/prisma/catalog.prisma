model Catalog {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  unit        ProductUnit @default(KG)
  imageUrl    String?
  category    String?
  isActive    Boolean     @default(true)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy     User?          @relation("CatalogCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orderItems    OrderItem[]
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  stockMovements StockMovement[]

  @@map("Product")
  @@index([name])
  @@index([category])
  @@index([isActive])
}
